<!-- One prayer: name on the start side, time on the end. Fills its row so larger widgets spread out. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/prayer_cell_root"
 android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:minHeight="28dp"
 android:layout_marginHorizontal="2dp" android:layout_marginVertical="1dp"
 android:gravity="center_vertical" android:paddingHorizontal="8dp" android:paddingVertical="2dp" android:layoutDirection="rtl">
 <TextView android:id="@+id/prayer_cell_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
  android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
 <TextView android:id="@+id/prayer_cell_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
  android:textSize="15sp" android:textStyle="bold" android:layout_marginStart="4dp" android:textDirection="ltr"
  android:maxLines="1" android:includeFontPadding="false" />
</LinearLayout>
