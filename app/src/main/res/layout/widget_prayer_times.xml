<!-- Grid shape (about 2x2 cells): header, then six times in three rows of two. Rows share the
     remaining height so a taller widget spreads the table instead of leaving a gap. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/prayer_widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:layoutDirection="rtl" android:paddingHorizontal="12dp" android:paddingVertical="10dp"
 android:background="@drawable/bg_prayer_widget">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
  <TextView android:id="@+id/prayer_widget_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
   android:text="@string/prayer_widget_name" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:textColor="#191C1A" />
  <TextView android:id="@+id/prayer_widget_city" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
   android:layout_marginStart="6dp" android:text="@string/prayer_widget_location" android:textSize="11sp" android:maxLines="1"
   android:ellipsize="end" android:textColor="#43493F" />
 </LinearLayout>
 <TextView android:id="@+id/prayer_widget_next" android:layout_width="match_parent" android:layout_height="wrap_content"
  android:paddingTop="2dp" android:paddingBottom="6dp" android:maxLines="1" android:ellipsize="end"
  android:text="@string/prayer_widget_setup" android:textSize="13sp" android:textStyle="bold" android:textColor="#3A6931" />
 <LinearLayout android:id="@+id/prayer_widget_grid" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
  <LinearLayout android:id="@+id/prayer_widget_row1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" />
  <LinearLayout android:id="@+id/prayer_widget_row2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" />
  <LinearLayout android:id="@+id/prayer_widget_row3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" />
 </LinearLayout>
</LinearLayout>
