<?xml version="1.0" encoding="utf-8"?>
<!--
    The 108dp adaptive canvas is masked to a circle, squircle or rounded square by the launcher;
    only the central 66dp circle is guaranteed to stay visible. The «نور» letters reach 58% of the
    logo's width from its centre, so at 52dp they stay within ~30dp of the centre and are never
    cropped. The logo's brown matches ic_launcher_background, so its own rounded edge is invisible.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="52dp"
        android:height="52dp"
        android:drawable="@drawable/ic_nour_adhkar_logo"
        android:gravity="center" />
</layer-list>
